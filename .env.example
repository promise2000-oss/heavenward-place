# ─────────────────────────────────────────────────────────────────────────────
# HEAVENWARD PLACE — ENVIRONMENT
#
# This is a static site. There is no server, no database, no API and no
# authentication, so there is nothing here that a deployment *requires*.
# Every value below has a working default; the site runs with no .env at all.
#
# Copy to `.env.local` only if you need to override one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site identity ───────────────────────────────────────────────────────────
# Used for canonical URLs, the sitemap, robots.txt and Open Graph tags.
# Set this to your production origin before deploying.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Heavenward Place"

# ── Contact details ─────────────────────────────────────────────────────────
# These are the destinations for the enquiry hand-off: every form builds a
# mailto: or WhatsApp link using them, and the guest chooses to send.
NEXT_PUBLIC_SUPPORT_PHONE="+234 800 000 0000"
NEXT_PUBLIC_SUPPORT_EMAIL="stay@heavenwardplace.com"
NEXT_PUBLIC_SUPPORT_WHATSAPP="2348000000000"

# ── Reserved ────────────────────────────────────────────────────────────────
# Analytics is currently a no-op: `track()` in src/lib/analytics.ts records
# nothing. The call sites remain so a provider is a one-function change.
NEXT_PUBLIC_ANALYTICS_ID=
